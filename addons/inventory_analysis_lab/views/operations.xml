<odoo>
<menuitem id="menu_root" name="Inventory Analysis Lab" groups="inventory_analysis_lab.group_user"/>
<record id="view_runs_list" model="ir.ui.view"><field name="name">inventory.analysis.run.list</field><field name="model">inventory.analysis.run</field><field name="arch" type="xml"><list><field name="name"/><field name="company_id"/><field name="location_ids"/><field name="date_from"/><field name="date_to"/><field name="repetitions"/><field name="synthetic_products"/><field name="synthetic_movements"/><field name="state"/><field name="slow_seconds"/><field name="optimized_seconds"/></list></field></record>
<record id="view_runs_form" model="ir.ui.view"><field name="name">inventory.analysis.run.form</field><field name="model">inventory.analysis.run</field><field name="arch" type="xml"><form><header><button type="object" name="action_generate_synthetic" string="Generate Fictional Moves"/><button type="object" name="action_measure" string="Measure Both Implementations"/><button type="object" name="action_create_candidate_index" string="Create Candidate Index"/></header><sheet><group><field name="name"/><field name="company_id"/><field name="location_ids"/><field name="date_from"/><field name="date_to"/><field name="repetitions"/><field name="synthetic_products"/><field name="synthetic_movements"/><field name="state"/><field name="slow_seconds"/><field name="optimized_seconds"/></group><group><field name="measurements"/><field name="rows"/></group></sheet></form></field></record>
<record id="action_runs" model="ir.actions.act_window"><field name="name">Inventory Benchmarks</field><field name="res_model">inventory.analysis.run</field><field name="view_mode">list,form</field></record><menuitem id="menu_runs" name="Inventory Benchmarks" parent="menu_root" action="action_runs"/>
</odoo>
